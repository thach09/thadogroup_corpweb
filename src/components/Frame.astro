---
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import { copy, type Language } from '../data/content';
interface Props { lang: Language; missing?: boolean }
const { lang, missing = false } = Astro.props;
const t = copy[lang];
const vi = new URL('/', Astro.site).href;
const en = new URL('/en/', Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#102447" />
    <title>{missing ? '404 | THADO GROUP' : t.title}</title>
    <meta name="description" content={missing ? 'Trang không tồn tại · Page not found' : t.description} />
    <meta property="og:site_name" content="THADO GROUP" />
    <meta property="og:title" content={missing ? '404 | THADO GROUP' : t.title} />
    <meta property="og:description" content={missing ? 'Trang không tồn tại · Page not found' : t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={lang === 'vi' ? vi : en} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta property="og:image" content={new URL('/brand/logo.png', Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/brand/logo.png', Astro.site).href} />
    {(!import.meta.env.PUBLIC_INDEX_SITE || missing) && <meta name="robots" content="noindex, nofollow" />}
    {!missing && <>
      <link rel="canonical" href={lang === 'vi' ? vi : en} />
      <link rel="alternate" hreflang="vi" href={vi} />
      <link rel="alternate" hreflang="en" href={en} />
      <link rel="alternate" hreflang="x-default" href={vi} />
    </>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script is:inline src="/site.js" defer></script>
  </head>
  <body><slot /></body>
</html>

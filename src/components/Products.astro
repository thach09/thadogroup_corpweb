---
import { copy, type Language } from '../data/content';
import { products } from '../data/products';
interface Props { lang: Language }
const t = copy[Astro.props.lang];
---
<section class="products" id="products" aria-labelledby="product-title" tabindex="-1">
  <div class="wrap">
    <h2 id="product-title" class="section-title" data-reveal>{t.productTitle}</h2>
    <div class="product-grid">
      {products.map(p => {
        const isClickable = p.status === 'available' && Boolean(p.url);
        return (
          <article class:list={['product', p.id, { 'is-clickable': isClickable }]} data-reveal>
            {isClickable && <a class="card-link" href={p.url} aria-label={p.name}></a>}
            <span class="glyph" aria-hidden="true" lang={p.id === 'ganbarou' ? 'ja' : 'zh'}>{p.id === 'ganbarou' ? 'が' : '中'}</span>
            <h3>{p.name}</h3>
            <p>{t.productDescriptions[p.id]}</p>
            {isClickable ? (
              <div class="product-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            ) : (
              <span class="soon">{t.soon}</span>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>
